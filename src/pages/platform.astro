---
import BaseLayout from '../layouts/BaseLayout.astro';

const workspace = [
  {
    name: 'ERP',
    text: 'Customers, suppliers, orders, invoices and the records that tie them together.',
  },
  {
    name: 'Projects',
    text: 'Project, phase, task. Each level carries its own dates, owners, costs and documents.',
  },
  {
    name: 'Documents',
    text: 'Files attached to the records they belong to, with access rules by role.',
  },
  {
    name: 'Knowledge library',
    text: 'Manuals, procedures, references and decisions, organised so they can be found and cited.',
  },
  {
    name: 'Stakeholders',
    text: 'Companies and the people in them: clients, suppliers, partners, authorities. One record per entity, contacts within it.',
  },
  {
    name: 'Calendar',
    text: 'Dates from projects, tasks and records in one view.',
  },
  {
    name: 'Finance',
    text: 'Budgets, costs and receivables alongside the projects and stakeholders they belong to.',
  },
  {
    name: 'Inventory',
    text: 'Items, quantities and locations, linked to the orders and projects that move them.',
  },
];
---

<BaseLayout
  title="Platform"
  description="The three pieces of Ownpremise: Core, the engine built in Rust; Workspace, with ERP, projects, documents, knowledge library, stakeholders, calendar, finance and inventory; and Assistant, a private assistant over your own documents with local models."
>
  <section class="hero blueprint">
    <div class="wrap">
      <span class="eyebrow"><span class="num">00</span>Platform</span>
      <h1>Three pieces. One installation.</h1>
      <p class="lede" style="margin-top: 1.5rem">
        Ownpremise is installed once, on your server, and licensed per installation. Core is the
        engine, Workspace is what people use every day, and Assistant answers questions over your own
        documents. Ownpremise runs on hardware you or your partner control. There is no hosted tier.
      </p>
    </div>
  </section>

  <section class="section" id="core">
    <div class="wrap">
      <div class="piece-head">
        <span class="eyebrow"><span class="num">01</span>Core</span>
        <h2>Ownpremise Core</h2>
        <p class="lede">The engine. Everything else runs on it, and nothing reaches the data except through it.</p>
        <ul class="chips" aria-label="Deployment profiles">
          <li class="chip">Sealed</li>
          <li class="chip">Connected</li>
        </ul>
      </div>
      <div class="grid grid-2">
        <div>
          <h3>Application server</h3>
          <p>
            Built in Rust. Clients talk to the application server, and only the application server
            talks to the database. Every read and every write passes through the same permissions and
            the same audit trail.
          </p>
        </div>
        <div>
          <h3>Database</h3>
          <p>On your server, reachable from the application server alone. Not exposed to the network.</p>
        </div>
        <div>
          <h3>Signed builds and a licence file</h3>
          <p>
            Every release is signed and verified before it is installed. The licence file states which
            modules are active and for which installation.
          </p>
        </div>
        <div>
          <h3>Updates served by your own server</h3>
          <p>
            Updates arrive as signed bundles, placed on your server by you or your partner, and served
            from there to your clients. No client fetches software from outside.
          </p>
        </div>
        <div>
          <h3>Tamper-evident audit trail</h3>
          <p>
            Who did what and when, append-only. There is no screen, no role and no setting that alters
            or deletes an entry.
          </p>
        </div>
        <div>
          <h3>Hardware keys</h3>
          <p>Sign-in uses WebAuthn. Administrators can require a hardware key for every account.</p>
        </div>
      </div>
    </div>
  </section>

  <div class="blueprint divider" aria-hidden="true"></div>

  <section class="section" id="workspace">
    <div class="wrap">
      <div class="piece-head">
        <span class="eyebrow"><span class="num">02</span>Workspace</span>
        <h2>Ownpremise Workspace</h2>
        <p class="lede">What your people use every day. One set of records, one set of permissions, one audit trail.</p>
        <ul class="chips" aria-label="Deployment profiles">
          <li class="chip">Sealed</li>
          <li class="chip">Connected</li>
        </ul>
      </div>
      <div class="grid grid-2">
        {workspace.map((m) => (
          <div>
            <h3>{m.name}</h3>
            <p>{m.text}</p>
          </div>
        ))}
      </div>
      <dl class="facts" style="margin-top: 2.5rem">
        <div>
          <dt>Multilingual</dt>
          <dd>The interface is available in English (UK), Spanish, German, Italian and French. Each user chooses their own language.</dd>
        </div>
        <div>
          <dt>Modules switch on by licence</dt>
          <dd>Your licence states which modules are active. Switching one on does not require a new installation, and switching one off does not remove its records.</dd>
        </div>
        <div>
          <dt>One instance per customer</dt>
          <dd>Each customer runs a separate instance. Nothing is shared between customers: not the database, not the index, not the server.</dd>
        </div>
        <div>
          <dt>One instance per requirement</dt>
          <dd>Where a requirement calls for it, a single customer can run more than one instance: one per subsidiary, per site or per level of sensitivity.</dd>
        </div>
      </dl>
    </div>
  </section>

  <div class="blueprint divider" aria-hidden="true"></div>

  <section class="section" id="assistant">
    <div class="wrap">
      <div class="piece-head">
        <span class="eyebrow"><span class="num">03</span>Assistant</span>
        <h2>Ownpremise Assistant</h2>
        <p class="lede">A private assistant over your own documents, with local models. The deployment profile decides what leaves, if anything.</p>
        <ul class="chips" aria-label="Deployment profiles">
          <li class="chip">Sealed</li>
          <li class="chip">Connected</li>
          <li class="chip">Controlled egress</li>
          <li class="chip">Integrated</li>
        </ul>
      </div>
      <div class="grid grid-2">
        <div>
          <h3>Over your own documents</h3>
          <p>
            Ask in plain language across the documents, records and knowledge library in your instance.
            Answers cite their sources, so they can be checked.
          </p>
        </div>
        <div>
          <h3>Same permissions as the person asking</h3>
          <p>The assistant reads only what the user asking is allowed to read. There is no separate, wider view.</p>
        </div>
        <div>
          <h3>Local models by default</h3>
          <p>Models run on your server. In the Sealed and Connected profiles that is the only option, and nothing leaves.</p>
        </div>
        <div>
          <h3>What leaves is a profile setting</h3>
          <p>
            Controlled egress sends only to destinations you list, masked by data class and logged.
            Integrated uses external models only for data you have classified as safe to send.
          </p>
        </div>
      </div>
      <p class="after"><a href="/deployment">The four profiles, with what leaves and what you accept</a></p>
    </div>
  </section>

  <section class="band blueprint">
    <div class="wrap">
      <span class="eyebrow"><span class="num">04</span>Status</span>
      <h2>In evaluation with early partners.</h2>
      <p class="measure" style="margin-top: 1.25rem">
        The pieces above are the ones that exist today. We do not list what is planned. If you need
        something that is not here, say so when you request an evaluation and we will tell you plainly
        whether it is coming.
      </p>
      <div class="btn-row">
        <a class="btn" href="/contact">Request an evaluation</a>
        <a class="btn btn-ghost" href="/deployment">Deployment profiles</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .piece-head {
    margin-bottom: 2.5rem;
  }

  .piece-head .lede {
    margin-top: 1rem;
  }

  .piece-head .chips {
    margin-top: 1.5rem;
  }

  .after {
    margin-top: 2rem;
  }
</style>
