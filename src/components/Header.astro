---
import Mark from './Mark.astro';

const items = [
  { href: '/platform', label: 'Platform' },
  { href: '/deployment', label: 'Deployment' },
  { href: '/security', label: 'Security' },
  { href: '/partners', label: 'Partners' },
  { href: '/contact', label: 'Contact' },
];

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="wordmark" aria-label="Ownpremise, home">
      <Mark size={20} class="mark" />
      <span>ownpremise</span>
    </a>
    <nav aria-label="Primary">
      <ul>
        {items.map((item) => (
          <li>
            <a href={item.href} aria-current={current === item.href ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--rule);
    background: var(--bg);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding-block: 1rem;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: -0.03em;
    text-decoration: none;
    color: var(--fg);
  }

  .wordmark :global(.mark) {
    color: var(--accent);
  }

  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
  }

  nav a {
    display: inline-block;
    padding-block: 0.25rem;
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--fg-muted);
    border-bottom: 2px solid transparent;
  }

  nav a:hover {
    color: var(--fg);
  }

  nav a[aria-current='page'] {
    color: var(--fg);
    border-bottom-color: var(--accent);
  }

  @media (min-width: 40rem) {
    .bar {
      flex-wrap: nowrap;
    }
  }
</style>
