---
// The Ownpremise mark: an outlined copper square (your premises) with a small
// filled dot inside it (the instance, inside). Colour follows the parent.
interface Props {
  size?: number;
  class?: string;
}
const { size = 20, class: className } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 20 20"
  fill="none"
  aria-hidden="true"
  class={className}
>
  <rect x="1" y="1" width="18" height="18" rx="1" stroke="currentColor" stroke-width="2" />
  <circle cx="10" cy="10" r="2.75" fill="currentColor" />
</svg>
